{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug im_client",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["build", "--bin=im_client", "--manifest-path", "${workspaceFolder}/rust/Cargo.toml"],
                "filter": { "name": "im_client", "kind": "bin" }
            },
            "args": [],
            "cwd": "${workspaceFolder}/rust",
            "console": "integratedTerminal",
            "env": {
                "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT": "http://localhost:4317",
                "OTEL_SERVICE_NAME": "rust_lib",
                "RUST_LOG": "debug"
            }
        },
        {
            "name": "Flutter (windows)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "deviceId": "linux",
            "env": {
                "FLUTTER_COLOR": "true"
            }
        },
        {
            "name": "Flutter (Android Emulator-5554)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "deviceId": "emulator-5554",
            "env": {
                "RUST_LOG": "debug",
                "PUB_HOSTED_URL": "https://pub.flutter-io.cn",
                "FLUTTER_STORAGE_BASE_URL": "https://storage.flutter-io.cn",
                "FLUTTER_COLOR": "true"
            }
        },
        {
            "name": "Flutter (Android Debug)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "args": [
                "--debug"
            ],
            "deviceId": "android",
            "env": {
                "FLUTTER_COLOR": "true"
            }
        },
        {
            "name": "Flutter (Android Profile)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "flutterMode": "profile",
            "deviceId": "android",
            "env": {
                "FLUTTER_COLOR": "true"
            }
        }
    ]
}