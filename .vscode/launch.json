{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug im_client",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["build", "--bin=im_client", "--manifest-path", "${workspaceFolder}/rust/Cargo.toml"],
                "filter": { "name": "im_client", "kind": "bin" }
            },
            "args": [],
            "cwd": "${workspaceFolder}/rust",
            "console": "internalConsole",
            "env": {
                "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT": "http://localhost:4317",
                "OTEL_SERVICE_NAME": "rust_lib"
            }
        },
        {
            "name": "Flutter (Android)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "deviceId": "android"
        },
        {
            "name": "Flutter (Android Debug)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "args": [
                "--debug"
            ],
            "deviceId": "android"
        },
        {
            "name": "Flutter (Android Profile)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "flutterMode": "profile",
            "deviceId": "android"
        },{
        }
    ]
}