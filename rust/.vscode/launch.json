{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug im_client",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["build", "--bin=im_client"],
                "filter": { "name": "im_client", "kind": "bin" }
            },
            "args": [],
            "env": {
                "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT": "http://localhost:4318/v1/traces",
                "OTEL_SERVICE_NAME": "rust_lib"
            },
            "cwd": "${workspaceFolder}/rust",
            "console": "integratedTerminal"
        }
    ]
}
